# kovanica-chain environment template — copy to .env and fill in.
# NEVER commit .env or any real key. .env is gitignored; prefer a keystore
# over raw private keys for anything past a throwaway local devnet.

# L1 endpoint (local devnet / Sepolia / mainnet as appropriate)
L1_RPC_URL=
# Required only if batches use EIP-4844 blobs. Devnet default DA is calldata.
L1_BEACON_URL=

# L1 contract deployer. Prefer a keystore over a raw env key.
# On Sepolia the docs recommend a 1.5–3.5 ETH buffer for the deployer.
DEPLOYER_PRIVATE_KEY=

# Batcher / proposer roles. On Sepolia fund each with ~0.5 test ETH.
BATCHER_PRIVATE_KEY=
PROPOSER_PRIVATE_KEY=

# Only if running op-challenger against a non-devnet network.
CHALLENGER_PRIVATE_KEY=
